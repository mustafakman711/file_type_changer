<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.19041.0</TargetFramework><SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest><UseWPF>true</UseWPF><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained>
    <AssemblyName>Nashi</AssemblyName><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublishSingleFile>false</PublishSingleFile><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Nashi.Core/Nashi.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <Resource Include="../../Resources/Brand/NashiIcon.png" Link="Assets/NashiIcon.png" />
    <Resource Include="../../Resources/Brand/NashiMark.png" Link="Assets/NashiMark.png" />
    <Resource Include="../../Resources/Brand/NashiMarkHappy.png" Link="Assets/NashiMarkHappy.png" />
    <Resource Include="../../Resources/Sounds/WheelSelection.wav" Link="Assets/WheelSelection.wav" />
    <Content Include="../../Resources/PagesInterop.js" Link="PagesInterop.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../scripts/pages-windows.js" Link="pages-windows.js" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Resources/licenses/cupertino-files/**" Link="licenses/cupertino-files/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../licenses/**" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="155.0.8044" />
  </ItemGroup>
  <!-- Explorer integration: the menu icon, and NashiShell.exe (the IExplorerCommand
       server for the Windows 11 top-level menu) published into the same folder. -->
  <ItemGroup>
    <Content Include="../../Resources/Brand/NashiMenu.ico" Link="NashiMenu.ico" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../Nashi.Shell/Nashi.Shell.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>
  <Target Name="PublishExplorerMenuServer" AfterTargets="Publish">
    <MSBuild Projects="../Nashi.Shell/Nashi.Shell.csproj" Targets="Publish" Properties="Configuration=$(Configuration);PublishDir=$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)','$(PublishDir)'))))" />
  </Target>
</Project>

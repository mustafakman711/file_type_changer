<Project Sdk="Microsoft.NET.Sdk">
  <!-- NashiShell.exe: the out-of-process IExplorerCommand server behind the
       Windows 11 top-level Explorer menu (registered by the signed sparse
       package in windows/Packaging). No WPF, no Nashi.Core dependencies: it
       starts in milliseconds and only routes requests to Nashi.exe. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>NashiShell</AssemblyName><RootNamespace>Nashi.Shell</RootNamespace><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest><TieredPGO>false</TieredPGO>
    <PublishSingleFile>false</PublishSingleFile><DebugType>none</DebugType><DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Nashi.Core/FeatureCatalog.cs" Link="Shared/FeatureCatalog.cs" />
    <Compile Include="../Nashi.Core/LaunchCommand.cs" Link="Shared/LaunchCommand.cs" />
    <EmbeddedResource Include="../../Resources/FeatureCatalog.json" LogicalName="Nashi.FeatureCatalog.json" />
  </ItemGroup>
</Project>
